{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cpWIRE",
  "version": "0.1.0",
  "identifier": "group.armonie.cpwire",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "npm --prefix web run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "cp|WIRE",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "transparent": true,
        "decorations": true,
        "url": "https://cpwire.onrender.com/?desktop=1",
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active"
        }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
